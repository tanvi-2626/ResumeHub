# ---------- Server ----------
PORT=5000
# Any long random text. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ---------- Database: option A - separate settings (local MySQL) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=resumeflow

# ---------- Database: option B - one connection URL (cloud hosts) ----------
# If set, this is used instead of option A.
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Turn on if your database provider requires SSL:
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false   # only if the provider uses its own CA certificate

# ---------- Optional ----------
# Number of proxies in front of the app (1 on Render/Railway/Fly/Heroku). Use 0 if none.
# TRUST_PROXY=1
